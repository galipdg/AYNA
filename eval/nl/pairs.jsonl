{"id": "sample-028", "app": "sample", "appVersion": "1.0", "scenarioType": "dialog", "scenario": "sample-dialog-discard-no", "style": "terse", "tags": ["informal"], "origin": "team", "author": "galip", "text": "eposta: ali@ornek.com, geri, onay penceresi cikmali, soru 'Atmak istiyor musunuz?' icermeli, hayir", "gold": {"version": "0.2", "steps": [{"keyword": "Type", "target": "detail.emailInput", "value": "ali@ornek.com"}, {"keyword": "Click", "target": "detail.backButton"}, {"keyword": "Verify", "target": "discardDialog.window", "checkpoint": {"property": "visible", "operator": "equals", "expected": true}}, {"keyword": "Verify", "target": "discardDialog.questionLabel", "checkpoint": {"property": "name", "operator": "contains", "expected": "Atmak istiyor musunuz?"}}, {"keyword": "Click", "target": "discardDialog.noButton"}]}, "notes": "Starts on a fresh detail form (6.1). penceresi cikmali has no literal, so it is visible on the dialog window (4.2)."}
