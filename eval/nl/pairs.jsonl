{"id": "sample-031", "app": "sample", "appVersion": "1.0", "scenarioType": "wizard", "scenario": "sample-wizard-kalite", "style": "imperative", "origin": "team", "author": "galip", "text": "Ad Soyad alanına 'Ayşe Çelik' yaz, İleri'ye tıkla, departman olarak 'Kalite Güvence' seç, tekrar İleri'ye bas ve özette 'Kalite Güvence' geçtiğini doğrula.", "gold": {"version": "0.2", "steps": [{"keyword": "Type", "target": "wizard.nameInput", "value": "Ayşe Çelik"}, {"keyword": "Click", "target": "wizard.nextButton"}, {"keyword": "Select", "target": "wizard.departmentCombo", "value": "Kalite Güvence"}, {"keyword": "Click", "target": "wizard.nextButton"}, {"keyword": "Verify", "target": "wizard.summaryLabel", "checkpoint": {"property": "name", "operator": "contains", "expected": "Kalite Güvence"}}]}, "notes": "SC-20's first five steps. özette is the summary label (3. adım)."}
