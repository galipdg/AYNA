{"id": "sample-001", "app": "sample", "appVersion": "1.0", "scenarioType": "login", "scenario": "sample-login-ok", "style": "imperative", "origin": "team", "author": "hasan", "text": "Kullanıcı adı alanına admin yaz, şifre alanına admin yaz, Giriş butonuna tıkla ve durum etiketinde 'Hoş geldiniz, admin!' yazdığını doğrula.", "gold": {"version": "0.2", "steps": [{"keyword": "Type", "target": "login.userNameInput", "value": "admin"}, {"keyword": "Type", "target": "login.passwordInput", "value": "admin"}, {"keyword": "Click", "target": "login.loginButton"}, {"keyword": "Verify", "target": "login.statusLabel", "checkpoint": {"property": "name", "operator": "equals", "expected": "Hoş geldiniz, admin!"}}]}}
