{"id": "sample-006", "app": "sample", "appVersion": "1.0", "scenarioType": "form", "scenario": "sample-form-save", "style": "imperative", "origin": "team", "author": "hasan", "text": "Ad Soyad alanına 'Ayşe Çelik', e-posta alanına ayse.celik@ornek.com yaz, departman olarak 'Test ve Doğrulama' seç, Kaydet'e tıkla ve durum etiketinde 'Kayıt kaydedildi' yazdığını doğrula.", "gold": {"version": "0.2", "steps": [{"keyword": "Type", "target": "detail.nameInput", "value": "Ayşe Çelik"}, {"keyword": "Type", "target": "detail.emailInput", "value": "ayse.celik@ornek.com"}, {"keyword": "Select", "target": "detail.departmentCombo", "value": "Test ve Doğrulama"}, {"keyword": "Click", "target": "detail.saveButton"}, {"keyword": "Verify", "target": "detail.statusLabel", "checkpoint": {"property": "name", "operator": "equals", "expected": "Kayıt kaydedildi"}}]}, "notes": "Starts on a fresh detail form (6.1): empty fields, the first department."}
