{
  "$comment": "Named test cases for step.schema.json. A case gives either a whole `document` or a single `step`, which the tests wrap in a document of the schema's version. Invalid cases name the JSON Schema keyword (`rule`) that must reject them; `false` means a property the keyword does not allow. `since` marks cases added after 0.1; the others are the 0.1 cases, kept unchanged apart from the document version.",
  "valid": [
    {
      "name": "empty test",
      "document": { "version": "0.2", "steps": [] }
    },
    {
      "name": "NL suggestion without ids",
      "document": {
        "version": "0.2",
        "steps": [
          { "keyword": "Type", "target": "main.searchInput", "value": "Yılmaz" },
          { "keyword": "Click", "target": "main.searchButton" }
        ]
      }
    },
    {
      "name": "Type with an empty value clears the field",
      "step": { "keyword": "Type", "target": "main.searchInput", "value": "" }
    },
    {
      "name": "Verify that a text box is empty",
      "step": {
        "keyword": "Verify",
        "target": "main.searchInput",
        "checkpoint": { "property": "value", "operator": "equals", "expected": "" }
      }
    },
    {
      "name": "Verify name with notEquals",
      "step": {
        "keyword": "Verify",
        "target": "login.statusLabel",
        "checkpoint": { "property": "name", "operator": "notEquals", "expected": "Invalid username or password" }
      }
    },
    {
