{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Spike-only schema for #7. NOT the frozen contract schemas/step.schema.json.",
  "title": "SpikeStepList",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "enum": ["Click", "Type", "Select", "Verify", "Wait"]
          },
          "target": { "type": "string", "minLength": 1 },
          "value": { "type": "string" }
        },
        "required": ["keyword", "target", "value"],
        "additionalProperties": false
      }
    }
  },
  "required": ["steps"],
  "additionalProperties": false
}
