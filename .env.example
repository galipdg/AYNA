# Copy to .env and fill in. Never commit .env.
NEO4J_URI=bolt://localhost:7687
# Neo4j takes this password only when its volume is first created (change it with `docker compose down -v`, which deletes the data); at least 8 characters. Compose always uses the user neo4j.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# Host port Compose publishes the server on; change it (and AYNA_SERVER_URL) when another program holds 8080 (#208).
AYNA_SERVER_PORT=8080
AYNA_SERVER_URL=http://localhost:8080
# First admin, created only while no admin account exists (#60); at least 8 characters.
AYNA_ADMIN_USERNAME=admin
AYNA_ADMIN_PASSWORD=change-me-too
AYNA_AI_URL=http://localhost:8090
OLLAMA_HOST=http://localhost:11434
