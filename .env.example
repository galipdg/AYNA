# Copy to .env and fill in. Never commit .env.
NEO4J_URI=bolt://localhost:7687
# Neo4j takes this password only when its volume is first created (change it with `docker compose down -v`, which deletes the data); at least 8 characters. Compose always uses the user neo4j.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# Host port Compose publishes the server on; change it (and AYNA_SERVER_URL) when another program holds 8080 (#208).
AYNA_SERVER_PORT=8080
AYNA_SERVER_URL=http://localhost:8080
# First admin, created only while no admin account exists (#60); at least 8 characters.
AYNA_ADMIN_USERNAME=admin
AYNA_ADMIN_PASSWORD=change-me-too
# Runs (#51). Compose keeps screenshots in the volume `screenshots`; back it up with Neo4j's.
# Retention keeps the newest N runs of the whole server (0 = keep all; use 0 while an experiment
# such as #69 or #86 is measured, or other runs evict its results); a running run with no
# write for the idle timeout ends as aborted. A screenshot upload may be at most the max size.
AYNA_RUN_RETENTION=1000
AYNA_RUN_IDLE_TIMEOUT=60m
AYNA_SCREENSHOT_MAX_SIZE=8MB
AYNA_AI_URL=http://localhost:8090
OLLAMA_HOST=http://localhost:11434
